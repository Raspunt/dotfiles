#!/bin/bash
# Случайные обои через awww. Использование: randwall [папка]
DIR="${1:-/mnt/big/Pictures/bg}"

if ! pgrep -x awww-daemon >/dev/null; then
    setsid awww-daemon >/dev/null 2>&1 &
    for _ in $(seq 25); do
        awww query >/dev/null 2>&1 && break
        sleep 0.2
    done
fi

img=$(find "$DIR" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) | shuf -n 1)
[ -n "$img" ] || { echo "randwall: в $DIR нет картинок" >&2; exit 1; }

awww img --transition-type wipe --transition-duration 2 "$img"
