#!/usr/bin/env python3

import subprocess
import os
import random
import time
import json
from abc import ABC, abstractmethod

WALLPAPER_DIR = "/mnt/big/bg/wallz/Green Lush"
# WALLPAPER_DIR = "/mnt/big/bg/natrure_walls/"

# Абстрактный базовый класс для установки обоев
class WallpaperEngine(ABC):
    
    @abstractmethod
    def get_monitors(self):
        """Получить список мониторов"""
        pass
    
    @abstractmethod
    def set_wallpaper(self, wallpaper):
        """Установить обои"""
        pass
    
    @abstractmethod
    def set_random_wallpaper(self):
        """Установить случайные обои"""
        pass

# Конкретная реализация для Hyprland
class HyprlandWallpaper(WallpaperEngine):
    
    def get_monitors(self):
        """Получить мониторы через hyprctl"""
        try:
            # Используем JSON для более надежного парсинга
            result = subprocess.run(
                ["hyprctl", "monitors", "-j"],
                capture_output=True, text=True, check=True
            )
            monitors_data = json.loads(result.stdout)
            monitors = [monitor["name"] for monitor in monitors_data]
            return monitors
        except (subprocess.CalledProcessError, json.JSONDecodeError):
            # Fallback на текстовый вывод
            text = subprocess.run(
                ["hyprctl", "monitors"],
                capture_output=True, text=True
            ).stdout
            monitors = []
            for line in text.splitlines():
                if line.strip().startswith("Monitor"):
                    monitors.append(line.split()[1])
            return monitors
    
    def set_wallpaper(self, wallpaper):
        """Установить обои через hyprpaper"""
        subprocess.run(["hyprctl", "hyprpaper", "reload", ",", wallpaper])
    
    def set_wallpaper_per_monitor(self, wallpapers_dict):
        """Установить разные обои для каждого монитора"""
        for monitor, wallpaper in wallpapers_dict.items():
            cmd = f"hyprctl hyprpaper preload {wallpaper} && hyprctl hyprpaper wallpaper {monitor},{wallpaper}"
            subprocess.run(cmd, shell=True)
    
    def set_random_wallpaper(self):
        """Установить случайные обои"""
        wallpapers = self._load_wallpapers()
        if not wallpapers:
            return
        
        wallpaper = random.choice(wallpapers)
        monitors = self.get_monitors()
        
        # Установить одинаковые обои на все мониторы
        for monitor in monitors:
            subprocess.run([
                "hyprctl", "hyprpaper", "wallpaper", 
                f"{monitor},{wallpaper}"
            ])
    
    def _load_wallpapers(self):
        """Загрузить список обоев"""
        return [os.path.join(WALLPAPER_DIR, f) 
                for f in os.listdir(WALLPAPER_DIR) 
                if f.lower().endswith(('.png', '.jpg', '.jpeg', '.webp'))]

# Конкретная реализация для других WM через swww
class SwwwWallpaper(WallpaperEngine):
    
    def get_monitors(self):
        """Получить мониторы через swww"""
        try:
            # Пробуем получить через swww query
            result = subprocess.run(
                ["swww", "query"],
                capture_output=True, text=True
            )
            
            if result.returncode == 0:
                monitors = []
                for line in result.stdout.splitlines():
                    if "Monitor" in line:
                        # Пример строки: "Monitor DP-1: 1920x1080@144Hz"
                        monitor_name = line.split(":")[0].replace("Monitor", "").strip()
                        monitors.append(monitor_name)
                return monitors
            
            # Fallback на xrandr
            return self._get_monitors_xrandr()
            
        except (subprocess.CalledProcessError, FileNotFoundError):
            return self._get_monitors_xrandr()
    
    def _get_monitors_xrandr(self):
        """Получить мониторы через xrandr"""
        try:
            result = subprocess.run(
                ["xrandr", "--query"],
                capture_output=True, text=True
            )
            monitors = []
            for line in result.stdout.splitlines():
                if " connected " in line:
                    monitor_name = line.split()[0]
                    monitors.append(monitor_name)
            return monitors
        except:
            return ["DP-1"]  # Fallback
    
    def set_wallpaper(self, wallpaper):
        """Установить обои через swww"""
        # Инициализируем swww если он не запущен
        subprocess.run(["swww", "init"], stderr=subprocess.DEVNULL)
        
        # Устанавливаем обои
        subprocess.run([
            "swww", "img", 
            "--transition-type", "wipe",
            "--transition-duration", "2",
            wallpaper
        ])
    
    def set_wallpaper_per_monitor(self, wallpapers_dict):
        """Установить разные обои для каждого монитора"""
        # Инициализируем swww если он не запущен
        subprocess.run(["swww", "init"], stderr=subprocess.DEVNULL)
        
        for monitor, wallpaper in wallpapers_dict.items():
            subprocess.run([
                "swww", "img", 
                "--outputs", monitor,
                "--transition-type", "wipe",
                "--transition-duration", "2",
                wallpaper
            ])
    
    def set_random_wallpaper(self):
        """Установить случайные обои"""
        wallpapers = self._load_wallpapers()
        if not wallpapers:
            return
        
        wallpaper = random.choice(wallpapers)
        self.set_wallpaper(wallpaper)
    
    def _load_wallpapers(self):
        """Загрузить список обоев"""
        return [os.path.join(WALLPAPER_DIR, f) 
                for f in os.listdir(WALLPAPER_DIR) 
                if f.lower().endswith(('.png', '.jpg', '.jpeg', '.webp'))]

# Фабрика для создания движков обоев
class WallpaperEngineFactory:
    
    @staticmethod
    def create_engine(engine_type=None):
        """Создать движок обоев на основе окружения или указанного типа"""
        if engine_type:
            return WallpaperEngineFactory._create_by_type(engine_type)
        
        # Автодетект окружения
        if WallpaperEngineFactory._is_hyprland():
            return HyprlandWallpaper()
        else:
            return SwwwWallpaper()
    
    @staticmethod
    def _create_by_type(engine_type):
        """Создать движок по указанному типу"""
        engines = {
            "hyprland": HyprlandWallpaper,
            "hyprpaper": HyprlandWallpaper,
            "swww": SwwwWallpaper,
            "default": SwwwWallpaper
        }
        
        engine_class = engines.get(engine_type.lower(), SwwwWallpaper)
        return engine_class()
    
    @staticmethod
    def _is_hyprland():
        """Проверить, запущен ли Hyprland"""
        # Способ 1: Проверка переменной окружения
        if os.getenv("HYPRLAND_INSTANCE_SIGNATURE"):
            return True
        
        # Способ 2: Проверка процесса
        try:
            result = subprocess.run(
                ["pgrep", "-x", "Hyprland"],
                capture_output=True
            )
            return result.returncode == 0
        except:
            return False
        
        # Способ 3: Проверка через hyprctl
        try:
            subprocess.run(["hyprctl", "version"], 
                          capture_output=True, check=True)
            return True
        except:
            return False

# Главный класс для управления обоями
class WallpaperManager:
    
    def __init__(self, engine_type=None):
        self.engine = WallpaperEngineFactory.create_engine(engine_type)
        self.engine_name = self.engine.__class__.__name__
    
    def set_random(self):
        """Установить случайные обои"""
        print(f"Устанавливаю случайные обои через {self.engine_name}...")
        self.engine.set_random_wallpaper()
    
    def set_specific(self, wallpaper_path):
        """Установить конкретные обои"""
        if os.path.exists(wallpaper_path):
            print(f"Устанавливаю обои '{wallpaper_path}' через {self.engine_name}...")
            self.engine.set_wallpaper(wallpaper_path)
        else:
            print(f"Файл не найден: {wallpaper_path}")
    
    def set_different_for_monitors(self):
        """Установить разные обои на каждый монитор"""
        monitors = self.engine.get_monitors()
        wallpapers = self.engine._load_wallpapers()
        
        if len(wallpapers) < len(monitors):
            print("Недостаточно обоев для всех мониторов!")
            return
        
        selected = random.sample(wallpapers, len(monitors))
        wallpapers_dict = dict(zip(monitors, selected))
        
        print(f"Устанавливаю разные обои через {self.engine_name}...")
        if hasattr(self.engine, 'set_wallpaper_per_monitor'):
            self.engine.set_wallpaper_per_monitor(wallpapers_dict)
        else:
            # Fallback - устанавливаем первую картинку на все мониторы
            self.engine.set_wallpaper(selected[0])
    
    def show_monitors(self):
        """Показать список мониторов"""
        monitors = self.engine.get_monitors()
        print(f"Обнаружено мониторов: {len(monitors)}")
        for i, monitor in enumerate(monitors, 1):
            print(f"  {i}. {monitor}")

# Функции для обратной совместимости
def check_desktop():
    """Определить движок обоев (устаревшая функция)"""
    manager = WallpaperManager()
    return manager.engine_name

def set_random_wallpaper():
    """Установить случайные обои (устаревшая функция)"""
    manager = WallpaperManager()
    manager.set_random()

if __name__ == "__main__":
    import argparse
    
    parser = argparse.ArgumentParser(description="Установщик обоев")
    parser.add_argument("--random", action="store_true", help="Установить случайные обои")
    parser.add_argument("--file", type=str, help="Установить конкретный файл обоев")
    parser.add_argument("--different", action="store_true", help="Разные обои на каждый монитор")
    parser.add_argument("--monitors", action="store_true", help="Показать мониторы")
    parser.add_argument("--engine", type=str, choices=["hyprland", "swww"], 
                       help="Принудительно указать движок")
    
    args = parser.parse_args()
    
    # Создаем менеджер
    manager = WallpaperManager(args.engine)
    
    # Выполняем действия
    if args.monitors:
        manager.show_monitors()
    elif args.file:
        manager.set_specific(args.file)
    elif args.different:
        manager.set_different_for_monitors()
    else:  # По умолчанию - случайные обои
        manager.set_random()