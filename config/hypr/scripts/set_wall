#!/usr/bin/env python3

import subprocess
import os
import sys

def set_wallpaper(image_path):
    
    if not os.path.exists(image_path):
        print(f"Ошибка: файл не найден: {image_path}")
        sys.exit(1)
    
    ext = os.path.splitext(image_path)[1].lower()
    if ext not in ['.png', '.jpg', '.jpeg', '.webp', '.gif', '.bmp']:
        print(f"Ошибка: неподдерживаемый формат {ext}")
        sys.exit(1)
    
    abs_path = os.path.abspath(image_path)
    
    try:
        result = subprocess.run(
            ["hyprctl", "monitors", "-j"],
            capture_output=True, text=True, check=True
        )
        import json
        monitors_data = json.loads(result.stdout)
        monitors = [m["name"] for m in monitors_data]
    except Exception as e:
        print(f"Ошибка получения мониторов: {e}")
        sys.exit(1)

    # Устанавливаем на все мониторы
    for monitor in monitors:
        result = subprocess.run(
            ["hyprctl", "hyprpaper", "wallpaper", f"{monitor},{abs_path}"],
            capture_output=True, text=True
        )
        if result.returncode != 0:
            print(f"Ошибка установки на {monitor}: {result.stderr}")
        else:
            print(f"✓ {monitor}: {abs_path}")

if __name__ == "__main__":
    if len(sys.argv) != 2:
        print(f"Использование: {sys.argv[0]} <путь_к_изображению>")
        sys.exit(1)
    
    set_wallpaper(sys.argv[1])