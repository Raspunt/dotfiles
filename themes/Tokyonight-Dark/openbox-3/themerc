# Tokyonight (Night) для labwc/Openbox-3
# Палитра совпадает с ~/.config/waybar/style-labwc.css

border.width: 2

window.active.border.color: #7aa2f7
window.inactive.border.color: #414868

window.active.title.bg: Solid
window.active.title.bg.color: #1a1b26
window.inactive.title.bg: Solid
window.inactive.title.bg.color: #16161e

window.active.label.text.color: #c0caf5
window.inactive.label.text.color: #565f89
window.label.text.justify: Center

window.active.button.unpressed.image.color: #c0caf5
window.inactive.button.unpressed.image.color: #565f89
window.button.hover.bg.color: #292e4280
window.button.hover.bg.corner-radius: 4

window.active.shadow.size: 16
window.active.shadow.color: #00000090
window.inactive.shadow.size: 10
window.inactive.shadow.color: #00000060

menu.border.width: 2
menu.border.color: #414868
menu.width.min: 180
menu.width.max: 280
menu.items.bg.color: #1a1b26
menu.items.text.color: #c0caf5
menu.items.active.bg.color: #292e42
menu.items.active.text.color: #ffffff
menu.separator.color: #414868
menu.title.bg.color: #1a1b26
menu.title.text.color: #7aa2f7

osd.bg.color: #1a1b26
osd.border.width: 2
osd.border.color: #7aa2f7
osd.label.text.color: #c0caf5
osd.window-switcher.style-classic.item.active.border.color: #7aa2f7
osd.window-switcher.style-classic.item.active.bg.color: #292e42
